PORT=5001
NODE_ENV=development

# ─── Database ───────────────────────────────────────────────────────────────────
# For LOCAL development (your machine's MongoDB):
# MONGODB_URI=mongodb://localhost:27017/healthcare_game

# For using the PRODUCTION database locally (copy from Vercel → Settings → Environment Variables):
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Auth ───────────────────────────────────────────────────────────────────────
# Must match the JWT_SECRET value set in Vercel environment variables!
JWT_SECRET=your_jwt_secret_here

# ─── Email (for OTP / password reset) ──────────────────────────────────────────
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password
